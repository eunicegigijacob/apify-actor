{
    "name": "api-documentation-extractor",
    "version": "0.1.0",
    "type": "module",
    "description": "Turn API documentation into structured, machine-readable API intelligence.",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "@crawlee/cheerio": "^3.15.3",
        "cheerio": "^1.1.0",
        "js-yaml": "^4.1.0",
        "playwright": "^1.55.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.58.0",
        "vitest": "^3.2.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "author": "",
    "license": "ISC"
}
